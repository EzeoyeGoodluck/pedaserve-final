# Server side (Vercel > Settings > Environment Variables). Not needed locally
# unless you run `vercel dev`.
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_TO=info@pedaserve.com
CONTACT_FROM=Pedaserve website <website@pedaserve.com>

# Optional overrides: point a form at another service instead of /api/contact.
VITE_CONTACT_ENDPOINT=
VITE_NEWSLETTER_ENDPOINT=
